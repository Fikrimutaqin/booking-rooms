# Port backend server
PORT=3000

# URL Database PostgreSQL Serverless (Prisma Postgres / Neon / Supabase)
# Catatan: Gunakan Connection Pooling URL untuk DATABASE_URL:
DATABASE_URL="postgresql://username:password@ep-sample-12345.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Direct Connection URL (digunakan khusus untuk migration CLI / deploy):
DIRECT_URL="postgresql://username:password@ep-sample-12345.region.aws.neon.tech/neondb?sslmode=require"

# Kunci JWT untuk Autentikasi
JWT_SECRET="super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="super-secret-refresh-jwt-key-change-this-in-production"
JWT_REFRESH_EXPIRES_IN="7d"
