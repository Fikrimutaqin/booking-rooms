    "@nestjs/passport": "^12.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.4.1",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^11.0.0",
